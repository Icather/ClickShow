<Window
    x:Class="ClickShow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ClickShow"
    xmlns:l="clr-namespace:ClickShow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Name="TheWindow"
    Title="ClickShow"
    Width="450"
    Height="450"
    MinWidth="250"
    MinHeight="100"
    ResizeMode="CanMinimize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="20,30,20,40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Vertical">

            <CheckBox
                Name="ChkStartWithWindows"
                Margin="5"
                VerticalContentAlignment="Center"
                Click="ChkStartWithWindows_OnClick"
                Content="{x:Static l:Strings.AutoStart}"
                ToolTip="{x:Static l:Strings.AutoStartToolTip}" />

            <StackPanel Name="PnlSettings" DataContext="{Binding ElementName=TheWindow, Path=AppSetting}">
                <CheckBox
                    Name="ChkEnableClickCircle"
                    Margin="5"
                    VerticalContentAlignment="Center"
                    Content="{x:Static l:Strings.EnableClickCircle}"
                    IsChecked="{Binding Path=EnableClickCircle}"
                    ToolTip="{x:Static l:Strings.ClickCircleToolTip}" />


                <CheckBox
                    Name="ChkEnableHoverDot"
                    Margin="5"
                    VerticalContentAlignment="Center"
                    Content="{x:Static l:Strings.EnableHoverDot}"
                    IsChecked="{Binding Path=EnableHoverDot}"
                    ToolTip="{x:Static l:Strings.HoverDotToolTip}" />


            </StackPanel>


        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Margin="10" HorizontalAlignment="Center">
                <Hyperlink NavigateUri="https://github.com/cuiliang/clickshow" RequestNavigate="HyperlinkOpenHomepage_OnRequestNavigate"><TextBlock Text="{x:Static l:Strings.FeedbackLink}"/></Hyperlink>                
                <LineBreak></LineBreak>
                <TextBlock Name="LblNewVersion" Foreground="OrangeRed" FontWeight="Bold" Visibility="Collapsed" Text="{x:Static l:Strings.NewVersionAvailable}"/>
            </TextBlock>
            

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Name="BtnSettings"
                    Margin="5"
                    Padding="10,7"
                    Click="BtnSettings_OnClick"
                    Content="{x:Static l:Strings.MoreSettings}" />

                <Button
                    Name="BtnClose"
                    Grid.Column="1"
                    Margin="5"
                    Padding="10,7"
                    Click="BtnClose_OnClick"
                    Content="{x:Static l:Strings.Exit}" />
            </Grid>


        </StackPanel>
    </Grid>

</Window>
